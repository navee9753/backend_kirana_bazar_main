<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="v1.2-create-suppliers" author="copilot">
        <createTable tableName="suppliers">
            <column name="id" type="SERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="contact_person" type="VARCHAR(150)"/>
            <column name="phone_number" type="VARCHAR(15)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="company_brand" type="VARCHAR(150)"/>
            <column name="pending_payable" type="NUMERIC(14,2)" defaultValueNumeric="0.00"/>
            <column name="last_delivery_date" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="suppliers" indexName="idx_suppliers_name">
            <column name="name"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>